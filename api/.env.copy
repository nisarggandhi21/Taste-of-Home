MONGO = mongodb+srv://[username]:[password]@cluster
JWT_KEY = [your-jwt-secret]
STRIPE_SECRET_KEY = [your-stripe-secret]
# Optional: signing secret of a Stripe webhook pointing at /api/orders/webhook
STRIPE_WEBHOOK_SECRET = [your-stripe-webhook-secret]
PORT = 8800
# Set to 1 when the API runs behind one reverse proxy (Render, Railway, nginx, ...)
# TRUST_PROXY = 1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional: email for password reset and email confirmation. Any SMTP provider works.
# Without SMTP_HOST no email is sent and the rest of the site still works.
# CLIENT_URL = http://localhost:5173
# SMTP_HOST = smtp.example.com
# SMTP_PORT = 587
# SMTP_USER = [smtp-username]
# SMTP_PASS = [smtp-password]
# MAIL_FROM = Taste of Home <no-reply@example.com>

# Optional: turns on signed image uploads (the API signs each upload, the secret stays here).
# CLOUDINARY_CLOUD_NAME = [your-cloudinary-cloud-name]
# CLOUDINARY_API_KEY = [your-cloudinary-api-key]
# CLOUDINARY_API_SECRET = [your-cloudinary-api-secret]
