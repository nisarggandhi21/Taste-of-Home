# Backend
# The database started by docker compose. Use your own connection string to use another one.
MONGO=mongodb://mongo:27017/tasteofhome
JWT_KEY=replace-with-strong-jwt-secret
STRIPE_SECRET_KEY=sk_test_replace_me
# Optional: signing secret of a Stripe webhook pointing at /api/orders/webhook
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
PORT=8800
# Set to 1 when the API runs behind one reverse proxy (Render, Railway, nginx, ...)
# TRUST_PROXY=1
NODE_ENV=production

# Optional: email for password reset and email confirmation. Any SMTP provider works.
# Without SMTP_HOST no email is sent and the rest of the site still works.
# CLIENT_URL=http://localhost:5173
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=replace_me
# SMTP_PASS=replace_me
# MAIL_FROM=Taste of Home <no-reply@example.com>

# Optional: turns on signed image uploads (the API signs each upload, the secret stays here).
# CLOUDINARY_CLOUD_NAME=replace_me
# CLOUDINARY_API_KEY=replace_me
# CLOUDINARY_API_SECRET=replace_me

# Optional: turns on the AI features (assistant, smart search, listing drafts, review summaries).
# A free key from Google AI Studio is enough.
# GEMINI_API_KEY=replace_me
# AI_MODEL=gemini-4-hydrogen
# AI_EMBEDDING_MODEL=gemini-embedding-2
# AI_DAILY_LIMIT=500
# AI_HOURLY_LIMIT=30

# CORS
CORS_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend (Vite)
VITE_BASEURL=http://localhost:8800/api/
VITE_SUCCESS_URL=http://localhost:5173/success
# Optional: default to the project's test accounts when unset
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# VITE_CLOUDINARY_CLOUD_NAME=replace_me
# VITE_CLOUDINARY_UPLOAD_PRESET=replace_me
# Optional: shown on the Contact, About and Privacy pages
# VITE_CONTACT_EMAIL=hello@example.com
